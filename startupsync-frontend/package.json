{
  "name": "startupsync-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "ajv": "^8.20.0",
    "axios": "^1.6.0",
    "lucide-react": "^0.379.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "recharts": "^3.8.1",
    "sockjs-client": "^1.6.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/sockjs-client": "^1.5.4",
    "autoprefixer": "^10.4.14",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.27",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/index.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/index.css -o ./public/styles.css --watch",
    "prestart": "npm run build:css",
    "prebuild": "npm run build:css",
    "start": "npm-run-all --parallel watch:css start:app",
    "start:app": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
